# ────────────────────────────────────────────────────────────
# Memecoin Radar — environment configuration
# Copy to .env.local and fill in. NOTHING here is dummy data;
# features light up only when their key is present.
# ────────────────────────────────────────────────────────────

# --- Supabase (required for auth, watchlist, admin config, signal history) ---
# Create a free project at https://supabase.com then paste values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana RPC ---
# Free public endpoint works out of the box but is rate-limited.
# For production use a paid RPC (Helius / Triton / QuickNode).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Optional providers (features stay OFF until set) ---
# Helius: powers whale tracking, holder distribution, tx history.
#   Get a free key at https://helius.dev
HELIUS_API_KEY=
# Birdeye: richer price/holder data. https://birdeye.so
BIRDEYE_API_KEY=
# X / Twitter: cashtag mentions + sentiment folded into the signal score. Paid.
#   https://developer.x.com  (Basic tier ~$100/mo)
X_BEARER_TOKEN=
# Google Gemini: OPTIONAL AI analysis (directional lean + reasoning).
#   FREE key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Telegram ---
# Login (optional auth method): create a bot via @BotFather, set username (no @).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Bot token is used both for Telegram login AND for signal alerts.
TELEGRAM_BOT_TOKEN=
# Chat ID that signal alerts are sent to (a user id, or -100... for a group).
TELEGRAM_CHAT_ID=

# --- Auto-scanner (scheduled signal alerts) ---
# Secret that authorizes the /api/cron/scan endpoint. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Set a long random string.
CRON_SECRET=

# --- Session signing ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- First admin ---
# Wallet address that is auto-promoted to admin on first login.
BOOTSTRAP_ADMIN_WALLET=

# Break-glass admin recovery. If you lose the owner wallet, sign in with any
# method (Telegram / a new wallet), open /recover and paste this value to make
# that account the owner. Needs 24+ characters; leave blank to disable the
# feature entirely. Generate one with: openssl rand -hex 32

# --- Auto-buy (opt-in, server-signed) ---
# Base58 private key of a HOT wallet used to sign automated buys.
# Fund with only what you can afford to lose. Leave blank to keep auto-buy off.
AUTO_BUY_SIGNER_KEY=

# --- Email notifications (SMTP) ---
# Optional here: you can instead set every SMTP field in the Admin panel
# (stored in Supabase). These env values are only fallbacks used when the DB
# is empty. Works with any SMTP provider: Gmail app password, Resend, SendGrid,
# Mailgun, Postmark, Zoho, or your cPanel mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From header shown to recipients, e.g. "MemePump" <alerts@yourdomain.com>
SMTP_FROM=
# true only for implicit TLS on port 465; leave false for 587 (STARTTLS).
SMTP_SECURE=false

# --- App identity / links in emails ---
# Public base URL of your deployment (used for links inside emails).
# Auto-detected on Vercel; set explicitly for Render / cPanel.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=MemePump
