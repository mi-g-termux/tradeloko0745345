# MemePump environment template.
#
#   Local dev:  copy to .env.local
#   Docker:     copy to .env  (docker-compose.yml reads it)
#   Hosted:     paste these into the platform's env var UI
#
# NEVER commit the filled-in copy. .env* is gitignored.
# Generate the three secrets with:  openssl rand -hex 32

# ---------- REQUIRED: database ----------
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role bypasses ALL row-level security. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- REQUIRED: secrets ----------
# Signs session cookies.
SESSION_SECRET=
# Encrypts every custodial wallet private key. MUST be 64 hex chars.
# Lose this and all custodial wallets are unrecoverable. Back it up. Never rotate
# after launch.
WALLET_MASTER_KEY=
# Shared secret for the 9 cron endpoints. While unset, every cron route refuses.
CRON_SECRET=

# ---------- STRONGLY RECOMMENDED ----------
NEXT_PUBLIC_APP_NAME=MemePump
# Pins ONE canonical domain. Safe to leave blank: the app detects its own host
# from incoming requests, so cron URLs and links work on any platform.
NEXT_PUBLIC_APP_URL=
# Public RPC is heavily rate limited. Helius/QuickNode/Triton recommended.
SOLANA_RPC_URL=
# Makes owner bootstrap deterministic, and is your lockout escape hatch.
BOOTSTRAP_ADMIN_WALLET=

# ---------- EMAIL (admin code login + alerts) ----------
# Gmail needs an App Password, not your normal password.
# Port 587 -> SMTP_SECURE=false | port 465 -> SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# ---------- OPTIONAL: feature keys ----------
# Each unlocks one feature. The app runs fine with all of these empty.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
X_BEARER_TOKEN=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Only needed if you enable server-side auto-buy.
AUTO_BUY_SIGNER_KEY=

# ---------- ADMIN LOGIN DOOR (security) ----------
# The URL segment that serves the admin email-code login page.
# Unset  -> the page lives at /signin (public knowledge, guessable).
# Set    -> the page lives ONLY at /<your-value> and /signin returns a real 404.
# Use something unguessable. No slashes, no spaces.
#   example: ADMIN_LOGIN_PATH=k7x-control-9f2
ADMIN_LOGIN_PATH=

# Hard allowlist of addresses permitted to request a login code.
# Unset  -> any address may be submitted; only real admin accounts get a code.
# Set    -> every other address is rejected before any database or SMTP call,
#           so strangers cannot probe the form or trigger any email at all.
# Comma-separated. Strongly recommended.
#   example: ADMIN_LOGIN_EMAILS=you@gmail.com,partner@company.com
ADMIN_LOGIN_EMAILS=

# ---------- BUILD FLAG ----------
# Set to 1 for Docker / Fly / Cloud Run / VPS / cPanel / Plesk builds.
# Leave unset on Vercel and Netlify.
BUILD_STANDALONE=

# --- Extra AI providers (optional). Any subset can be set. ---
# Each key you add becomes another independent voter in the AI council, so the
# models cross-check each other and disagreement lowers the signal confidence.
# These can also be set in Admin -> Providers instead of here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Canonical public URL of your site, e.g. https://yourdomain.com
# Used for Telegram "Full analysis" buttons and email links. Prefer setting
# "Public site URL" in Admin -> Providers, which needs no redeploy.
NEXT_PUBLIC_APP_URL=
